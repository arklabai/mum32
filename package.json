{
  "name": "mum32",
  "displayName": "mum32 — Memory for your AI Harness & Coding Agents",
  "description": "Persistent memory engine and context ledger for your AI harness and coding agents (Claude, Cursor, Antigravity, Copilot)",
  "version": "0.1.1",
  "publisher": "arklabai",
  "homepage": "https://www.arklabai.com/mum32",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "AI",
    "prompt",
    "memory",
    "context",
    "agent",
    "copilot",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/arklabai/mum32"
  },
  "bugs": {
    "url": "https://github.com/arklabai/mum32/issues"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mum32-sidebar",
          "title": "mum32",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "mum32-sidebar": [
        {
          "type": "webview",
          "id": "mum32.sidebarView",
          "name": "Context Ledger",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "mum32.copyContextBlock",
        "title": "mum32: Copy Context Block",
        "icon": "$(clippy)"
      },
      {
        "command": "mum32.syncToAgentsMd",
        "title": "mum32: Sync to AGENTS.md",
        "icon": "$(sync)"
      },
      {
        "command": "mum32.capturePrompt",
        "title": "mum32: Capture Current Prompt from Clipboard",
        "icon": "$(add)"
      },
      {
        "command": "mum32.clearStale",
        "title": "mum32: Clear Stale Memories",
        "icon": "$(trash)"
      },
      {
        "command": "mum32.openSidebar",
        "title": "mum32: Open Sidebar",
        "icon": "$(brain)"
      },
      {
        "command": "mum32.checkConflicts",
        "title": "mum32: Scan Active File for Invariant Conflicts",
        "icon": "$(shield)"
      },
      {
        "command": "mum32.statusBarMenu",
        "title": "mum32: Open Quick Actions Menu",
        "icon": "$(sparkle)"
      }
    ],
    "keybindings": [
      {
        "command": "mum32.openSidebar",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m"
      },
      {
        "command": "mum32.copyContextBlock",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      },
      {
        "command": "mum32.syncToAgentsMd",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      },
      {
        "command": "mum32.capturePrompt",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "mum32.checkConflicts",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k"
      }
    ],
    "configuration": {
      "title": "mum32",
      "properties": {
        "mum32.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "Automatically keep AGENTS.md, .cursorrules, and CLAUDE.md in sync when memories change."
        },
        "mum32.syncTargets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "AGENTS.md",
            ".cursorrules",
            "CLAUDE.md"
          ],
          "description": "Target agent context files to synchronize with pinned rules."
        },
        "mum32.autoSyncOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically sync pinned constraints to agent files on every editor save."
        },
        "mum32.cloudApiKey": {
          "type": "string",
          "default": "",
          "description": "mum32 Cloud API key for multi-session vector sync (optional)."
        },
        "mum32.gitTrackLedger": {
          "type": "boolean",
          "default": true,
          "description": "Include .mum32/ledger.json in git tracking (share memory with team)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:all",
    "dev": "concurrently -n \"webview,ext\" -c \"cyan,magenta\" \"npm run watch:webview\" \"npm run watch:ext\"",
    "build:webview": "cd webview-ui && npm run build",
    "build:ext": "tsc -p ./tsconfig.json",
    "build:all": "npm run build:webview && npm run build:ext",
    "watch:ext": "tsc -watch -p ./tsconfig.json",
    "watch:webview": "cd webview-ui && npm run dev",
    "compile": "npm run build:all",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^5.3.0"
  }
}
